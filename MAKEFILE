# Open Watcom WMAKE. Default is DOS-hosted tools; no script runtime required.
!ifndef WATCOM
WATCOM=$(%WATCOM)
!endif
!ifndef HOST
HOST=dos
!endif
!ifndef TOOLBIN
!ifeq HOST nt64
TOOLBIN=$(WATCOM)\binnt64
!else ifeq HOST nt
TOOLBIN=$(WATCOM)\binnt
!else
TOOLBIN=$(WATCOM)\binw
!endif
!endif
AS=$(TOOLBIN)\wasm.exe
CC=$(TOOLBIN)\wcc.exe
CC32=$(TOOLBIN)\wcc386.exe
LD=$(TOOLBIN)\wlink.exe
RC=$(TOOLBIN)\wrc.exe
DOSASM=SOURCE\DOS\NNETDEF.INC SOURCE\DOS\NNETNE.INC SOURCE\DOS\NNETNIC.INC SOURCE\DOS\NNET3C.INC SOURCE\DOS\NNETRS.INC
DOSC=SOURCE\DOS\AGENT.C SOURCE\DOS\JOBS.C SOURCE\DOS\TREE.C SOURCE\DOS\SHELLUI.C SOURCE\DOS\LLPATH.H SOURCE\SHARED\AU.H SOURCE\SHARED\LLTREE.H
UTIL=SOURCE\DOS\LL\COMMON.C SOURCE\DOS\LLPATH.H
WINC=SOURCE\WIN32\HOST.C SOURCE\WIN32\STARTUP.INC SOURCE\WIN32\GUI.INC SOURCE\WIN32\PEER.C SOURCE\WIN32\QUEUE.C SOURCE\WIN32\STYLE.INC SOURCE\WIN32\TREE.C SOURCE\SHARED\AU.H SOURCE\SHARED\LLTREE.H
all: dos windows .SYMBOLIC
    @echo Build complete. Programs and maps are in OUT.
dos: OUT\LLSHELL.EXE OUT\LLTIME.EXE OUT\LLGET.EXE OUT\LLNIC.EXE OUT\NETDIAG.EXE OUT\AUMON.COM .SYMBOLIC
    @copy SOURCE\DOS\LLSTART.BAT OUT\LLSTART.BAT >NUL
windows: OUT\LLSH32.EXE .SYMBOLIC
setup: .SYMBOLIC
    @if not exist OUT\. md OUT
OUT\SHELLNET.OBJ: setup SOURCE\DOS\SHELLNET.ASM $(DOSASM)
    $(AS) -q -0 -dLITELINK_UI -i=SOURCE\DOS -fo=$@ SOURCE\DOS\SHELLNET.ASM
OUT\SYSTEM.OBJ: setup SOURCE\DOS\SYSTEM.ASM
    $(AS) -q -0 -fo=$@ SOURCE\DOS\SYSTEM.ASM
OUT\AGENT.OBJ: setup $(DOSC)
    $(CC) -q -bt=dos -0 -ms -s -zl -dLITELINK -dLL_UI -i=SOURCE\SHARED -fo=$@ SOURCE\DOS\AGENT.C
OUT\LLNET.OBJ: setup SOURCE\DOS\LL\LLNET.ASM SOURCE\DOS\START.ASM SOURCE\DOS\LL\LLWRAP.INC SOURCE\DOS\LL\LLUDP.INC $(DOSASM)
    $(AS) -q -0 -i=SOURCE\DOS -i=SOURCE\DOS\LL -fo=$@ SOURCE\DOS\LL\LLNET.ASM
OUT\TIME.OBJ: setup SOURCE\DOS\LL\TIME.C $(UTIL)
    $(CC) -q -bt=dos -0 -ms -s -zl -fo=$@ SOURCE\DOS\LL\TIME.C
OUT\GET.OBJ: setup SOURCE\DOS\LL\GET.C $(UTIL)
    $(CC) -q -bt=dos -0 -ms -s -zl -fo=$@ SOURCE\DOS\LL\GET.C
OUT\NIC.OBJ: setup SOURCE\DOS\LL\NIC.C $(UTIL)
    $(CC) -q -bt=dos -0 -ms -s -zl -fo=$@ SOURCE\DOS\LL\NIC.C
OUT\DIAGNET.OBJ: setup SOURCE\DOS\DIAG\DIAGNET.ASM SOURCE\DOS\START.ASM SOURCE\DOS\DIAG\WRAPPERS.INC SOURCE\DOS\DIAG\ICMP.INC SOURCE\DOS\DIAG\DIAGTX.INC $(DOSASM)
    $(AS) -q -0 -i=SOURCE\DOS -i=SOURCE\DOS\DIAG -fo=$@ SOURCE\DOS\DIAG\DIAGNET.ASM
OUT\NETDIAG.OBJ: setup SOURCE\DOS\DIAG\NETDIAG.C SOURCE\DOS\DIAG\DSTATE.H $(UTIL)
    $(CC) -q -bt=dos -0 -ms -s -zl -fo=$@ SOURCE\DOS\DIAG\NETDIAG.C
OUT\HOST.OBJ: setup $(WINC)
    $(CC32) @SOURCE\BUILD\HOST.CCF
OUT\AUMON.OBJ: setup SOURCE\DOS\AUMON.ASM
    $(AS) -q -0 -fo=$@ SOURCE\DOS\AUMON.ASM
OUT\LLSHELL.EXE: OUT\SHELLNET.OBJ OUT\AGENT.OBJ OUT\SYSTEM.OBJ SOURCE\BUILD\LLSHELL.LNK
    $(LD) @SOURCE\BUILD\LLSHELL.LNK
OUT\LLTIME.EXE: OUT\LLNET.OBJ OUT\TIME.OBJ SOURCE\BUILD\LLTIME.LNK
    $(LD) @SOURCE\BUILD\LLTIME.LNK
OUT\LLGET.EXE: OUT\LLNET.OBJ OUT\GET.OBJ SOURCE\BUILD\LLGET.LNK
    $(LD) @SOURCE\BUILD\LLGET.LNK
OUT\LLNIC.EXE: OUT\LLNET.OBJ OUT\NIC.OBJ SOURCE\BUILD\LLNIC.LNK
    $(LD) @SOURCE\BUILD\LLNIC.LNK
OUT\NETDIAG.EXE: OUT\DIAGNET.OBJ OUT\NETDIAG.OBJ SOURCE\BUILD\NETDIAG.LNK
    $(LD) @SOURCE\BUILD\NETDIAG.LNK
OUT\LLSH32.RES: setup SOURCE\WIN32\LLSH32.RC SOURCE\WIN32\LLICON.ICO
    $(RC) -q -r -bt=nt -i=SOURCE\WIN32 -fo=$@ SOURCE\WIN32\LLSH32.RC
OUT\LLSH32.EXE: OUT\HOST.OBJ OUT\LLSH32.RES SOURCE\BUILD\LLSH32.LNK
    $(LD) @SOURCE\BUILD\LLSH32.LNK
OUT\AUMON.COM: OUT\AUMON.OBJ SOURCE\BUILD\AUMON.LNK
    $(LD) @SOURCE\BUILD\AUMON.LNK


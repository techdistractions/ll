static HFONT ui_font,ui_bold;static HBRUSH ui_background,ui_white,ui_header,ui_select,ui_selectquiet,ui_stripe,ui_border;static int ui_row=23,ui_legacy;
static COLORREF ui_ink=RGB(42,51,65),ui_accent=RGB(25,89,153);
static void ui_theme(void){HDC dc=GetDC(0);int dpi=dc?GetDeviceCaps(dc,LOGPIXELSY):96,small=GetSystemMetrics(SM_CYSCREEN)<650;const char*face=(GetVersion()&255)>=5?"Segoe UI":"MS Sans Serif";int height=-((small?9:10)*dpi+36)/72;if(dc)ReleaseDC(0,dc);ui_legacy=(GetVersion()&255)<4;ui_row=-height+10;ui_font=CreateFontA(height,0,0,0,FW_NORMAL,0,0,0,ANSI_CHARSET,OUT_DEFAULT_PRECIS,CLIP_DEFAULT_PRECIS,DEFAULT_QUALITY,DEFAULT_PITCH|FF_SWISS,face);ui_bold=CreateFontA(height,0,0,0,FW_BOLD,0,0,0,ANSI_CHARSET,OUT_DEFAULT_PRECIS,CLIP_DEFAULT_PRECIS,DEFAULT_QUALITY,DEFAULT_PITCH|FF_SWISS,face);ui_background=CreateSolidBrush(RGB(243,246,250));ui_white=CreateSolidBrush(RGB(255,255,255));ui_header=CreateSolidBrush(RGB(231,237,245));ui_select=CreateSolidBrush(RGB(30,99,166));ui_selectquiet=CreateSolidBrush(RGB(111,137,165));ui_stripe=CreateSolidBrush(RGB(248,250,253));ui_border=CreateSolidBrush(RGB(199,210,223));if(ui_legacy){DeleteObject(ui_background);DeleteObject(ui_header);DeleteObject(ui_select);DeleteObject(ui_selectquiet);DeleteObject(ui_stripe);DeleteObject(ui_border);ui_background=CreateSolidBrush(RGB(255,255,255));ui_header=CreateSolidBrush(RGB(192,192,192));ui_select=CreateSolidBrush(RGB(0,0,128));ui_selectquiet=CreateSolidBrush(RGB(128,128,128));ui_stripe=CreateSolidBrush(RGB(255,255,255));ui_border=CreateSolidBrush(RGB(128,128,128));ui_ink=RGB(0,0,0);}}
static void ui_theme_free(void){if(ui_font)DeleteObject(ui_font);if(ui_bold)DeleteObject(ui_bold);if(ui_background)DeleteObject(ui_background);if(ui_white)DeleteObject(ui_white);if(ui_header)DeleteObject(ui_header);if(ui_select)DeleteObject(ui_select);if(ui_selectquiet)DeleteObject(ui_selectquiet);if(ui_stripe)DeleteObject(ui_stripe);if(ui_border)DeleteObject(ui_border);}
static void ui_text(HDC dc,RECT*r,const char*s,UINT align){DrawTextA(dc,s,-1,r,DT_SINGLELINE|DT_VCENTER|DT_NOPREFIX|align);}
static void ui_columns(HDC dc,RECT row,const char*name,const char*size,const char*date){RECT r=row;int width=row.right-row.left,dates=width>=330?104:0;r.left+=22;r.right=row.right-82-dates;ui_text(dc,&r,name,DT_LEFT);r.left=r.right+4;r.right=row.right-8-dates;ui_text(dc,&r,size,DT_RIGHT);if(dates){r.left=row.right-dates+8;r.right=row.right-8;ui_text(dc,&r,date,DT_LEFT);}}
static COLORREF ui_itemink(Item*i){unsigned k=itemkind(i->name,i->attr);if(ui_legacy)return k==1?RGB(0,0,128):(k==2?RGB(0,128,0):(k==3?RGB(128,0,0):(k==5?RGB(128,128,128):RGB(0,0,0))));return k==1?RGB(25,89,153):(k==2?RGB(24,116,70):(k==3?RGB(153,91,17):(k==4?RGB(67,75,116):(k==5?RGB(128,136,147):ui_ink))));}
static LRESULT ui_draw(DRAWITEMSTRUCT*d){RECT r=d->rcItem,mark;HBRUSH bg;COLORREF ink;HFONT old;char size[32],date[24],text[100];Item*it;unsigned n,y,m,day;int selected=(d->itemState&ODS_SELECTED)!=0;if(d->CtlType==ODT_BUTTON){int primary=d->CtlID==IDC_COPY||d->CtlID==IDC_COMMAND;bg=primary?ui_select:ui_white;if(d->itemState&ODS_SELECTED)bg=ui_selectquiet;FillRect(d->hDC,&r,bg);FrameRect(d->hDC,&r,ui_border);SetBkMode(d->hDC,TRANSPARENT);SetTextColor(d->hDC,primary||selected?RGB(255,255,255):ui_ink);old=SelectObject(d->hDC,ui_font);GetWindowTextA(d->hwndItem,text,sizeof(text));ui_text(d->hDC,&r,text,DT_CENTER);if(d->itemState&ODS_FOCUS){r.left+=3;r.top+=3;r.right-=3;r.bottom-=3;DrawFocusRect(d->hDC,&r);}SelectObject(d->hDC,old);return TRUE;}
 if(d->CtlType!=ODT_LISTBOX)return FALSE;if(d->itemID==(UINT)-1)return TRUE;n=d->CtlID==IDC_LOCAL?nl:nr;if(d->itemID>=n)return TRUE;it=(d->CtlID==IDC_LOCAL?locals:remotes)+d->itemID;bg=selected?(GetFocus()==d->hwndItem?ui_select:ui_selectquiet):(d->itemID&1?ui_stripe:ui_white);FillRect(d->hDC,&r,bg);ink=selected?RGB(255,255,255):ui_itemink(it);SetTextColor(d->hDC,ink);SetBkMode(d->hDC,TRANSPARENT);old=SelectObject(d->hDC,it->attr&16?ui_bold:ui_font);size[0]=date[0]=0;if(same(it->name,"."))textcopy(size,"Current");else if(same(it->name,".."))textcopy(size,"Parent");else if(it->attr&16)textcopy(size,"Folder");else numberstr(size,it->size);if(it->date&&!navname(it->name)){y=1980+(it->date>>9);m=(it->date>>5)&15;day=it->date&31;fixednum(date,y,4);date[4]='-';fixednum(date+5,m,2);date[7]='-';fixednum(date+8,day,2);date[10]=0;}ui_columns(d->hDC,r,it->name,size,date);mark=r;mark.left+=8;mark.right=mark.left+4;mark.top+=7;mark.bottom-=7;{HBRUSH colour=CreateSolidBrush(ink);if(colour){FillRect(d->hDC,&mark,colour);DeleteObject(colour);}}if(d->itemState&ODS_FOCUS)DrawFocusRect(d->hDC,&r);SelectObject(d->hDC,old);return TRUE;}
static void ui_headers(HWND h){PAINTSTRUCT ps;HDC dc=BeginPaint(h,&ps);RECT client,r;HFONT old;GetClientRect(h,&client);SetTextColor(dc,ui_legacy?RGB(0,0,0):RGB(78,95,116));SetBkMode(dc,TRANSPARENT);old=SelectObject(dc,ui_font);r.left=8;r.right=client.right/2-8;r.top=38;r.bottom=61;FillRect(dc,&r,ui_header);ui_columns(dc,r,"Name","Size / type","Modified");r.left=client.right/2+4;r.right=client.right-8;FillRect(dc,&r,ui_header);ui_columns(dc,r,"Name","Size / type","Modified");SelectObject(dc,old);EndPaint(h,&ps);}

static void ui_pathlabel(HWND h,const char*role,const char*path){HDC dc;HFONT old;RECT rect;SIZE sz;char label[300];unsigned skip=0,n=slen(path);if(!h)return;GetClientRect(h,&rect);dc=GetDC(h);old=SelectObject(dc,ui_bold?ui_bold:ui_font);for(;;){textcopy(label,role);if(skip)textcopy(label+slen(label),"...");textcopy(label+slen(label),path+skip);if(!GetTextExtentPointA(dc,label,slen(label),&sz)||sz.cx<=rect.right-4||skip==n)break;skip++;}SelectObject(dc,old);ReleaseDC(h,dc);SetWindowTextA(h,label);/* Erase the entire old path before painting a shorter one. */InvalidateRect(h,0,TRUE);UpdateWindow(h);}
